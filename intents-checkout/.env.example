PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intents_checkout
PUBLIC_BASE_URL=http://127.0.0.1:3000
MERCHANT_API_KEY=
ONE_CLICK_BASE_URL=https://1click.chaindefuser.com
ONE_CLICK_API_KEY=
# Mainnet NEAR account that receives USDC (plain account until checkout-policy is deployed)
TREASURY_ACCOUNT_ID=
# Optional overrides; defaults: native USDC on NEAR, 30 minutes, 100 bps
DESTINATION_ASSET_ID=
PAYMENT_WINDOW_MINUTES=
QUOTE_SLIPPAGE_BPS=
# Where payment status webhooks are POSTed. Empty means a status change writes no webhook.
WEBHOOK_URL=
# Set to false to refuse new payments. Tracking and reads continue.
CHECKOUT_ENABLED=
NEAR_NETWORK=mainnet
NEAR_RPC_URL=
POLICY_CONTRACT_ID=
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=
